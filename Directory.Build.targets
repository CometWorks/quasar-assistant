<Project>
  <!--
    Quasar.Plugin.Abstractions for projects that set UsesQuasarAbstractions. The QuasarHub installer passes
    QuasarPluginAbstractionsAssembly, the exact DLL of the running Quasar worker. Local builds use a Quasar
    checkout next to this repository (or QuasarPluginAbstractionsProject, as a property or environment
    variable), else the package.
  -->
  <PropertyGroup Condition="'$(UsesQuasarAbstractions)' == 'true'">
    <QuasarPluginAbstractionsProject Condition="'$(QuasarPluginAbstractionsProject)' == ''"
      >$(MSBuildThisFileDirectory)../Quasar/Quasar.Plugin.Abstractions/Quasar.Plugin.Abstractions.csproj</QuasarPluginAbstractionsProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(UsesQuasarAbstractions)' == 'true' and '$(QuasarPluginAbstractionsAssembly)' != '' and Exists('$(QuasarPluginAbstractionsAssembly)')">
    <Reference Include="Quasar.Plugin.Abstractions">
      <HintPath>$(QuasarPluginAbstractionsAssembly)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(UsesQuasarAbstractions)' == 'true' and ('$(QuasarPluginAbstractionsAssembly)' == '' or !Exists('$(QuasarPluginAbstractionsAssembly)')) and Exists('$(QuasarPluginAbstractionsProject)')">
    <ProjectReference Include="$(QuasarPluginAbstractionsProject)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsesQuasarAbstractions)' == 'true' and ('$(QuasarPluginAbstractionsAssembly)' == '' or !Exists('$(QuasarPluginAbstractionsAssembly)')) and !Exists('$(QuasarPluginAbstractionsProject)')">
    <PackageReference Include="Quasar.Plugin.Abstractions" Version="0.1.0-preview.1" />
  </ItemGroup>
</Project>
