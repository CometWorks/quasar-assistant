@* The chat drawer on every page (QuasarExtensionTargets.LayoutDrawer, policy CanUseAssistant). *@
@implements IDisposable
@inject SettingsStore Settings

@if (!_configured)
{
    @* Without a backend the chat can't answer, so only those who can add one see the launcher, as a link to the settings. *@
    <AuthorizeView Policy="@QuasarPolicyNames.CanManageSecurity">
        <a class="assistant-launcher" href="assistant/settings" title="Set up the assistant" aria-label="Set up the assistant: add a model backend">
            <AssistantIcon Icon="@AssistantIcons.Sparkles" />
        </a>
    </AuthorizeView>
}
else if (_open)
{
    <aside class="assistant-drawer" aria-label="Assistant">
        <header class="assistant-drawer-header">
            <h2>Assistant</h2>
            <button type="button" class="assistant-icon-button" title="New conversation" aria-label="New conversation" @onclick="New">
                <AssistantIcon Icon="@AssistantIcons.Add" />
            </button>
            <a class="assistant-icon-button" href="@(_conversationId is null ? "assistant/chat" : "assistant/chat/" + _conversationId)" title="Open on the Assistant page" aria-label="Open on the Assistant page">
                <AssistantIcon Icon="@AssistantIcons.OpenInNew" />
            </a>
            <button type="button" class="assistant-icon-button" title="Close" aria-label="Close the assistant" @onclick="() => _open = false">
                <AssistantIcon Icon="@AssistantIcons.Close" />
            </button>
        </header>
        <ChatView @key="_conversationId" ConversationId="@_conversationId" Page="@(new PageContext(PageUri, ServerName))" Compact="true"
                  ConversationStarted="id => _conversationId = id" />
    </aside>
}
else
{
    <button type="button" class="assistant-launcher" title="Assistant" aria-label="Open the assistant" @onclick="() => _open = true">
        <AssistantIcon Icon="@AssistantIcons.Sparkles" />
    </button>
}

@code {
    [Parameter] public string PageUri { get; set; } = "";
    [Parameter] public string? ServerName { get; set; }

    private bool _open;
    private bool _configured;
    private string? _conversationId;

    protected override void OnInitialized()
    {
        _configured = IsConfigured();
        Settings.Changed += OnSettingsChanged;
    }

    private bool IsConfigured() => Settings.Current.BackendsOf(AssistantRoles.Admin).Count > 0;

    private void OnSettingsChanged() =>
        _ = InvokeAsync(() =>
        {
            _configured = IsConfigured();
            StateHasChanged();
        });

    private void New() => _conversationId = null;

    public void Dispose() => Settings.Changed -= OnSettingsChanged;
}
