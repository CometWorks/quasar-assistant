<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>QuasarAssistant</AssemblyName>
    <RootNamespace>QuasarAssistant</RootNamespace>
    <UsesQuasarAbstractions>true</UsesQuasarAbstractions>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="QuasarAssistant.Tests" />
    <EmbeddedResource
      Include="Agent\system-prompt.md"
      LogicalName="QuasarAssistant.system-prompt.md"
    />
    <EmbeddedResource
      Include="Agent\monitor-system-prompt.md"
      LogicalName="QuasarAssistant.monitor-system-prompt.md"
    />
    <EmbeddedResource
      Include="Agent\player-system-prompt.md"
      LogicalName="QuasarAssistant.player-system-prompt.md"
    />
    <EmbeddedResource
      Include="QuasarBook\*.md;QuasarBook\COMMIT"
      LogicalName="QuasarAssistant.QuasarBook.%(Filename)%(Extension)"
    />
  </ItemGroup>
</Project>
