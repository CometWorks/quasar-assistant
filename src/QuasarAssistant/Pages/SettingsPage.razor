    private sealed class BackendForm
    {
        public string? Original { get; set; }
        public string Name { get; set; } = "";
        public BackendKind Kind { get; set; }
        public string BaseUrl { get; set; } = "";
        public string Model { get; set; } = "";
        public string? ApiKey { get; set; }
        public bool RemoveKey { get; set; }
        public int Priority { get; set; }
        public int Parallel { get; set; }
        public int ContextWindow { get; set; }
        public int MaxTokens { get; set; }
        public ThinkingLevel Thinking { get; set; }
        public double? FirstByteTimeout { get; set; }
        public double? StallTimeout { get; set; }
        public double Cooldown { get; set; }
        public double MaxCooldown { get; set; }
        public string Headers { get; set; } = "";
        public string ExtraBody { get; set; } = "";
        public double? InputPrice { get; set; }
        public double? CachedInputPrice { get; set; }
        public double? OutputPrice { get; set; }

        public static BackendForm From(BackendSettings? backend)
        {
            var b = backend ?? new BackendSettings();
            return new()
            {
                Original = backend?.Name,
                Name = b.Name,
                Kind = b.Kind,
                BaseUrl = b.BaseUrl,
                Model = b.Model,
                Priority = b.Priority,
                Parallel = b.Parallel,
                ContextWindow = b.ContextWindow,
                MaxTokens = b.MaxTokens,
                Thinking = b.Thinking,
                FirstByteTimeout = b.FirstByteTimeout,
                StallTimeout = b.StallTimeout,
                Cooldown = b.Cooldown,
                MaxCooldown = b.MaxCooldown,
                Headers = string.Join('\n', b.Headers.Select(pair => $"{pair.Key}: {pair.Value}")),
                ExtraBody = b.ExtraBody?.ToJsonString() ?? "",
                InputPrice = b.InputPrice,
                CachedInputPrice = b.CachedInputPrice,
                OutputPrice = b.OutputPrice,
            };
        }

        public string? Validate(AssistantSettings settings)
        {
            if (string.IsNullOrWhiteSpace(Name))
                return "A backend needs a name.";
            if (Name.Trim() != Original && settings.Backends.Any(b => b.Name == Name.Trim()))
                return $"There is already a backend named {Name.Trim()}.";
            if (!Uri.TryCreate(BaseUrl.Trim(), UriKind.Absolute, out var url) || url.Scheme is not ("http" or "https"))
                return "The base URL must be an http or https URL.";
            if (string.IsNullOrWhiteSpace(Model))
                return "A backend needs a model.";
            if (Headers.Split('\n').Any(line => line.Trim().Length > 0 && !line.Contains(':')))
                return "Write each header as Name: value.";
            if (ExtraBody.Trim().Length > 0)
            {
                try
                {
                    if (JsonNode.Parse(ExtraBody) is not JsonObject)
                        return "The extra body must be a JSON object.";
                }
                catch (System.Text.Json.JsonException error)
                {
                    return "The extra body isn't valid JSON: " + error.Message;
                }
            }
            return null;
        }

        public BackendSettings ToSettings() => new()
        {
            Name = Name.Trim(),
            Kind = Kind,
            BaseUrl = BaseUrl.Trim(),
            Model = Model.Trim(),
            Priority = Priority,
            Parallel = Math.Max(1, Parallel),
            ContextWindow = Math.Max(1024, ContextWindow),
            MaxTokens = Math.Max(16, MaxTokens),
            Thinking = Thinking,
            FirstByteTimeout = FirstByteTimeout is > 0 ? FirstByteTimeout : null,
            StallTimeout = StallTimeout is > 0 ? StallTimeout : null,
            Cooldown = Math.Max(0, Cooldown),
            MaxCooldown = Math.Max(Cooldown, MaxCooldown),
            Headers = Headers
                .Split('\n')
                .Where(line => line.Contains(':'))
                .Select(line => line.Split(':', 2))
                .GroupBy(parts => parts[0].Trim())
                .ToDictionary(group => group.Key, group => group.Last()[1].Trim()),
            ExtraBody = ExtraBody.Trim().Length > 0 ? JsonNode.Parse(ExtraBody)!.AsObject() : null,
            InputPrice = InputPrice is >= 0 ? InputPrice : null,
            CachedInputPrice = CachedInputPrice is >= 0 ? CachedInputPrice : null,
            OutputPrice = OutputPrice is >= 0 ? OutputPrice : null,
        };
    }
