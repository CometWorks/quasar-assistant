@inherits PanelComponent
@using QuasarAssistant.Skills

@* The admins' Markdown skills of one role, saved as they are edited to skills/<role>/ in the data folder. *@
<h3>Skills</h3>
<p class="assistant-hint">@Hint</p>
<ul class="assistant-checklist">
    @foreach (var skill in _skills)
    {
        <li>
            <button type="button" class="assistant-button" @onclick="() => Edit(skill)"><code>@skill.Name</code></button>
            <span class="assistant-hint">@skill.Summary</span>
        </li>
    }
</ul>
@if (_name is null)
{
    <button type="button" class="assistant-button" @onclick="() => Edit(null)"><AssistantIcon Icon="@AssistantIcons.Add" />Add a skill</button>
}
else
{
    <form class="assistant-form" @onsubmit="Done">
        <label>Name (letters, digits, - and _) <input required maxlength="64" readonly="@(_original is not null)" @bind="_name" @bind:after="AutoSave" /></label>
        <label class="assistant-wide-field">Markdown; the first line is its summary in the list
            <textarea class="assistant-wide" rows="14" maxlength="200000" @bind="_text" @bind:after="AutoSave"></textarea>
        </label>
        <div class="assistant-row">
            <button type="submit" class="assistant-button assistant-button-primary">Done</button>
            @if (_original is not null)
            {
                <button type="button" class="assistant-button" @onclick="Delete"><AssistantIcon Icon="@AssistantIcons.Delete" />Delete</button>
            }
        </div>
        @if (_error is not null)
        {
            <p class="assistant-error" role="alert">@_error</p>
        }
    </form>
}

@if (PanelError is not null) { <p class="assistant-error" role="alert">@PanelError</p> }

@code {
    [Parameter, EditorRequired] public string Role { get; set; } = "";

    private string? _original;
    private string? _name;
    private string _text = "";
    private string? _error;

    private string Hint => Role == AssistantRoles.Player
        ? "Text the player agent finds with its search and reads on demand, such as the server's FAQ and rules. Nothing here runs, and none of it is in the prompt until the agent reads it."
        : "Text the assistant finds with its search and reads on demand, next to the built-in Quasar book (Quasar " + BookCommit[..Math.Min(7, BookCommit.Length)] + "). Nothing here runs.";

    private void Edit(WrittenSkill? skill)
    {
        _original = skill?.Name;
        _name = skill?.Name ?? "";
        _text = skill?.Text ?? "";
        _error = null;
    }

    // Saved on every edit once it has a valid name; a new skill keeps that name from then on.
    private async Task<bool> Save()
    {
        var name = _name?.Trim() ?? "";
        if (!ValidName(name))
        {
            _error = "A skill name is 1 to 64 letters, digits, - or _.";
            return false;
        }
        if (_original is null && _skills.Any(skill => skill.Name == name))
        {
            _error = $"There is already a skill named {name}.";
            return false;
        }
        await Upload("skills.write", new SkillEdit(Role, name, _text, _original is null));
        await Refresh();
        _original = name;
        _error = null;
        return true;
    }

    private Task AutoSave() => Try(async () => { await Save(); });

    private Task Done() => Try(async () =>
    {
        if (await Save())
            _name = null;
    });

    private Task Delete() => Try(async () =>
    {
        if (_original is not null)
            await Upload("skills.write", new SkillEdit(Role, _original, null));
        await Refresh();
        _name = null;
    });
    [Parameter] public string BookCommit { get; set; } = "";
    private List<WrittenSkill> _skills = [];
    private Task Refresh() => Try(async () => _skills = await Read<List<WrittenSkill>>("skills.written",new ItemId(Role)));
    protected override Task OnParametersSetAsync() => Refresh();
}
